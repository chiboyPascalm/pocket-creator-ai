{
  "schema": 2,
  "tags": [
    "creator-ai"
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "creator-ai",
        "default": true,
        "default_size": {
          "w": 480,
          "h": 360
        },
        "min_size": {
          "w": 320,
          "h": 240
        }
      }
    ],
    "host_api": {
      "storage": [
        "get",
        "set"
      ],
      "window": [
        "set_title",
        "ready"
      ],
      "tools": [
        "required:bundled:creator-ai"
      ]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": [
      "fixtures/*.jsonl"
    ],
    "seed_storage": {},
    "user_id": 1
  },
  "host_capabilities": [
    "llm.sample"
  ],
  "required_executas": [
    {
      "tool_id": "bundled:creator-ai",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ]
}
